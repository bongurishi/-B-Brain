rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null; // Relax email_verified for standard Google Sign-In unless explicitly required
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId)) && 
             get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['ownerId', 'name', 'createdAt']) &&
        data.keys().size() <= 3 &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.createdAt == request.time;
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name']) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100;
      allow delete: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;

      function isValidIncident(data, pid) {
        return data.keys().hasAll(['projectId', 'title', 'learned', 'duration', 'date', 'createdAt']) &&
          data.keys().size() <= 6 &&
          data.projectId == pid &&
          data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
          data.learned is string && data.learned.size() >= 0 && data.learned.size() <= 500 &&
          data.duration is string && data.duration.size() >= 0 && data.duration.size() <= 50 &&
          data.date is string && data.date.size() >= 0 && data.date.size() <= 100 &&
          data.createdAt == request.time;
      }

      match /incidents/{incidentId} {
        allow get: if isSignedIn() && isValidId(projectId) && isValidId(incidentId) && isOwner(projectId);
        allow list: if isSignedIn() && isValidId(projectId) && isOwner(projectId);
        allow create: if isSignedIn() && isValidId(projectId) && isValidId(incidentId) && isOwner(projectId) && isValidIncident(incoming(), projectId);
        allow delete: if isSignedIn() && isValidId(projectId) && isValidId(incidentId) && isOwner(projectId);
      }

      function isValidSnapshot(data, pid) {
        return data.keys().hasAll(['projectId', 'engineLatency', 'eventLag', 'decisionTime', 'timestamp']) &&
          data.keys().size() <= 5 &&
          data.projectId == pid &&
          data.engineLatency is number &&
          data.eventLag is number &&
          data.decisionTime is number &&
          data.timestamp == request.time;
      }

      match /snapshots/{snapshotId} {
        allow get: if isSignedIn() && isValidId(projectId) && isValidId(snapshotId) && isOwner(projectId);
        allow list: if isSignedIn() && isValidId(projectId) && isOwner(projectId);
        allow create: if isSignedIn() && isValidId(projectId) && isValidId(snapshotId) && isOwner(projectId) && isValidSnapshot(incoming(), projectId);
        allow delete: if isSignedIn() && isValidId(projectId) && isValidId(snapshotId) && isOwner(projectId);
      }
    }
  }
}
